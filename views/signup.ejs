<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account | CareNova</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="container navbar">
        <a href="/" class="brand">
          <span class="brand-mark">✚</span>
          <span>CareNova</span>
        </a>
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/doctors">Doctors</a>
          <a href="/login">Login</a>
        </nav>
      </div>
    </header>

    <main class="auth-shell">
      <div class="auth-box">
        <span class="eyebrow">Create account</span>
        <h1>Create your CareNova account</h1>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="input-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/signup">
          <div class="form-grid-2">
            <label>
              Full name
              <input type="text" name="name" required />
            </label>

            <label>
              Email
              <input type="email" name="email" required />
            </label>

            <label>
              Password
              <input type="password" name="password" required />
            </label>

            <label>
              Account type
              <select name="role" id="role" required>
                <option value="patient">Patient</option>
                <option value="doctor">Doctor</option>
              </select>
            </label>

            <label>
              Phone
              <input type="text" name="phone" />
            </label>

            <label>
              City
              <input type="text" name="city" />
            </label>

            <label class="full-width doctor-field hidden">
              Specialty
              <input type="text" name="specialty" placeholder="e.g. Cardiology" />
            </label>

            <label class="doctor-field hidden">
              Experience (years)
              <input type="number" name="experience" min="0" value="0" />
            </label>

            <label class="doctor-field hidden">
              Consultation fee ($)
              <input type="number" name="fee" min="0" value="0" />
            </label>

            <label class="full-width doctor-field hidden">
              Bio
              <textarea name="bio" placeholder="Tell patients about your experience and care philosophy."></textarea>
            </label>
          </div>

          <div style="margin-top: 1.2rem;">
            <button class="btn btn-primary" type="submit">Create account</button>
          </div>
        </form>
      </div>
    </main>

    <script>
      const roleSelect = document.getElementById('role');
      const doctorFields = document.querySelectorAll('.doctor-field');
      function updateDoctorFields() {
        const isDoctor = roleSelect.value === 'doctor';
        doctorFields.forEach((field) => {
          field.classList.toggle('hidden', !isDoctor);
          const input = field.querySelector('input, textarea');
          if (input) input.disabled = !isDoctor;
        });
      }
      roleSelect.addEventListener('change', updateDoctorFields);
      updateDoctorFields();
    </script>
  </body>
</html>
